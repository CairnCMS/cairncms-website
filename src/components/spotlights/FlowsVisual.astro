---
// A flow on the canvas: an event hook trigger, a condition, and its resolve
// and reject branches. Panels settle in, the connections draw, and one run
// travels the resolve path. Its log then slides out over the canvas, as the
// app opens a run's log in a drawer rather than on the canvas itself.
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Panel = {
	id: string;
	x: number;
	y: number;
	w: number;
	h: number;
	icon: IconName;
	name: string;
	options: [string, string][];
	trigger?: boolean;
	reject?: boolean;
	ports: ('in' | 'resolve' | 'reject')[];
	d: number;
};

// Positions and sizes in em on the 40 x 25 stage.
const panels: Panel[] = [
	{
		id: 'trigger',
		x: 1.5,
		y: 2,
		w: 10,
		h: 12.5,
		icon: 'offline_bolt',
		name: 'Trigger',
		options: [
			['Type', 'Event Hook'],
			['Scope', 'items.update'],
			['Collections', 'products'],
		],
		trigger: true,
		ports: ['resolve'],
		d: 0,
	},
	{
		id: 'condition',
		x: 14.5,
		y: 8.3,
		w: 10,
		h: 8.5,
		icon: 'rule',
		name: 'Low on stock?',
		options: [['Rule', 'stock < 10']],
		ports: ['in', 'resolve', 'reject'],
		d: 150,
	},
	{
		id: 'reorder',
		x: 28.75,
		y: 2,
		w: 10.25,
		h: 8.5,
		icon: 'add',
		name: 'Reorder stock',
		options: [
			['Collection', 'purchase_orders'],
			['Payload', '{"quantity": 50, "product": "{{$trigger.keys[0]}}"}'],
		],
		ports: ['in', 'resolve'],
		d: 300,
	},
	{
		id: 'log',
		x: 28.75,
		y: 15,
		w: 10.25,
		h: 7.5,
		icon: 'terminal',
		name: 'Log skipped',
		options: [['Message', 'Plenty in stock']],
		reject: true,
		ports: ['in'],
		d: 380,
	},
];

const PORT = { in: 3.2, resolve: 3, reject: 1.4 };
const portY = (p: Panel, port: 'in' | 'resolve' | 'reject') =>
	port === 'in' ? p.y + PORT.in : p.y + p.h - PORT[port];

// Lines in stage units (10 per em). Each starts just right of its outgoing
// port and stops short of the input port, like the app's arrows.
const at = Object.fromEntries(panels.map((p) => [p.id, p]));
const units = (n: number) => Math.round(n * 100) / 10;
const out = (p: Panel, port: 'resolve' | 'reject'): [number, number] => [units(p.x + p.w + 0.9), units(portY(p, port))];
const into = (p: Panel): [number, number] => [units(p.x - 1.3), units(portY(p, 'in'))];

function route(from: [number, number], to: [number, number], bendX: number): [number, number][] {
	if (Math.abs(from[1] - to[1]) < 0.01) return [from, [to[0], from[1]]];
	return [from, [bendX, from[1]], [bendX, to[1]], to];
}

function roundedPath(pts: [number, number][], r = 4) {
	let d = `M${pts[0][0]} ${pts[0][1]}`;
	for (let i = 1; i < pts.length - 1; i++) {
		const [x0, y0] = pts[i - 1];
		const [x1, y1] = pts[i];
		const [x2, y2] = pts[i + 1];
		const l1 = Math.hypot(x1 - x0, y1 - y0);
		const l2 = Math.hypot(x2 - x1, y2 - y1);
		const rr = Math.min(r, l1 / 2, l2 / 2);
		d += ` L${x1 - ((x1 - x0) / l1) * rr} ${y1 - ((y1 - y0) / l1) * rr} Q${x1} ${y1} ${x1 + ((x2 - x1) / l2) * rr} ${y1 + ((y2 - y1) / l2) * rr}`;
	}
	const [lx, ly] = pts[pts.length - 1];
	return `${d} L${lx} ${ly}`;
}

const links = [
	{ id: 'trigger-condition', pts: route(out(at.trigger, 'resolve'), into(at.condition), 0), d: 500 },
	{ id: 'condition-reorder', pts: route(out(at.condition, 'resolve'), into(at.reorder), 266), d: 700 },
	{ id: 'condition-log', pts: route(out(at.condition, 'reject'), into(at.log), 266), reject: true, d: 760 },
].map((l) => {
	const [x, y] = l.pts[l.pts.length - 1];
	return { ...l, path: roundedPath(l.pts), head: `M${x - 4} ${y - 4} L${x} ${y} L${x - 4} ${y + 4}` };
});

// The run's log, step by step, as the drawer lists it.
const steps = [
	{ name: 'Trigger', type: 'Event Hook' },
	{ name: 'Low on stock?', type: 'Condition' },
	{ name: 'Reorder stock', type: 'Create Data' },
];
---

<div
	class="sv sv-fl position-relative overflow-hidden rounded"
	data-sv
	role="img"
	aria-label="A CairnCMS flow: an event hook trigger on products feeds a condition that creates a purchase order when a product runs low on stock and logs a message otherwise. A run travels the low-stock path, and its log opens in a drawer listing each step."
>
	<svg class="sv-fl__lines position-absolute top-0 start-0 w-100 h-100 overflow-visible" viewBox="0 0 400 250" aria-hidden="true">
		{
			links.map((l) => (
				<g class:list={['sv-fl__link', l.reject && 'is-reject']} style={`--d: ${l.d}`}>
					<path class="sv-fl__line" d={l.path} pathLength="100" />
					<path class="sv-fl__head" d={l.head} />
				</g>
			))
		}
		<path class="sv-fl__pulse sv-fl__pulse--1" d={links[0].path} pathLength="100" />
		<path class="sv-fl__pulse sv-fl__pulse--2" d={links[1].path} pathLength="100" />
	</svg>

	{
		panels.map((p) => (
			<div
				class:list={['sv-op position-absolute d-flex flex-column', `sv-op--${p.id}`, p.trigger && 'is-trigger', p.reject && 'is-reject', 'sv-rise']}
				style={`--x: ${p.x}; --y: ${p.y}; --w: ${p.w}; --h: ${p.h}; --d: ${p.d}`}
			>
				<div class="sv-op__head d-flex align-items-center fw-semibold text-nowrap">
					<Icon name={p.icon} />
					<span>{p.name}</span>
				</div>
				<dl class="sv-op__body d-flex flex-column m-0">
					{p.options.map(([label, value]) => (
						<div>
							<dt class="fw-medium">{label}</dt>
							<dd class="m-0 font-monospace text-truncate">{value}</dd>
						</div>
					))}
				</dl>
				{p.trigger && (
					<div class="sv-op__foot d-flex align-items-center mt-auto fw-medium">
						<span class="sv-op__dot rounded-circle" />
						Active
					</div>
				)}
				{p.ports.map((port) => (
					<span
						class={`sv-op__port is-${port} position-absolute d-grid rounded-circle ${port === 'in' ? 'start-0' : 'start-100'}`}
						style={`--py: ${port === 'in' ? PORT.in : p.h - PORT[port]}`}
					>
						<Icon name={port === 'in' ? 'adjust' : port === 'resolve' ? 'check_circle' : 'cancel'} />
					</span>
				))}
			</div>
		))
	}

	<div class="sv-layer sv-fl__drawer position-absolute z-1">
		<div class="sv-fl__drawer-head d-flex align-items-center">
			<span class="sv-round d-inline-grid flex-shrink-0 rounded-circle sv-round--soft"><Icon name="fact_check" /></span>
			<span class="sv-fl__drawer-title fw-semibold text-nowrap">10:42:07 AM</span>
			<span class="flex-fill"></span>
			<Icon name="close" />
		</div>
		<ol class="sv-fl__steps position-relative m-0 list-unstyled">
			{
				steps.map((s, i) => (
					<li class="position-relative d-flex align-items-baseline text-nowrap" style={`--i: ${i}`}>
						<span class="sv-fl__step-name fw-semibold">{s.name}</span>
						<span class="sv-fl__step-type">{s.type}</span>
					</li>
				))
			}
		</ol>
	</div>
</div>
