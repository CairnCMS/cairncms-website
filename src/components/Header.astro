<header>
	<nav class="navbar navbar-expand-md">
		<div class="container">
			<a class="navbar-brand" href="/">
				<img src="/logo/logo-flat-solid.svg" alt="CairnCMS logo: a stack of stones forming a cairn" />
				<span>CairnCMS</span>
			</a>

			<button
				class="navbar-toggler"
				type="button"
				aria-controls="cairn-nav"
				aria-expanded="false"
				aria-label="Toggle navigation"
				data-nav-toggle
			>
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="cairn-nav">
				<ul class="navbar-nav ms-auto align-items-md-center">
					<li class="nav-item">
						<a class="nav-link" href="/docs">Docs</a>
					</li>
					<li class="nav-item ms-md-2">
						<a class="btn btn-outline-light btn-sm d-inline-flex align-items-center gap-2" href="https://github.com/CairnCMS/cairncms" target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
								<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
							</svg>
							<span>GitHub</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const target = document.getElementById('cairn-nav');

	if (toggle && target) {
		toggle.addEventListener('click', () => {
			const open = target.classList.toggle('show');
			toggle.setAttribute('aria-expanded', String(open));
		});
	}
</script>
