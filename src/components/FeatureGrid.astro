---

<section class="section-pad section-border-top bg-stone-tint">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-8 text-center">
				<span class="eyebrow">Developer-First</span>
				<h2>Launch Faster with CairnCMS</h2>
				<p class="lead mt-3 mb-5">CairnCMS gives teams the APIs, webhooks, extensibility, identity integrations, and revision history that teams need alongside the core admin.</p>
			</div>
		</div>

		<div class="row g-4">
			{
				features.map((item) => (
					<div class="col-md-6 col-lg-3">
						<a class="feature-card" href={item.link}>
							<svg
								class="feature-card__icon"
								xmlns="http://www.w3.org/2000/svg"
								width="32"
								height="32"
								fill="currentColor"
								viewBox="0 0 16 16"
								aria-hidden="true"
								set:html={ICONS[item.icon]}
							/>
							<h3>{item.title}</h3>
							<p>{item.body}</p>
							{item.linkText && (
								<span class="feature-card__link">{item.linkText} →</span>
							)}
						</a>
					</div>
				))
			}
		</div>
	</div>
</section>
