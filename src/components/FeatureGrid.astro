---
const features = [
	{
		icon: 'code-slash',
		title: 'REST and GraphQL APIs',
		body: 'Every collection gets REST and GraphQL endpoints automatically with field selection, nested filtering, relational traversal, sorting, pagination, and aggregation.',
		link: '/docs/api/introduction/',
		linkText: 'Read the API reference',
	},
	{
		icon: 'braces',
		title: 'Typed JavaScript SDK',
		body: 'Connect any JavaScript app to CairnCMS with @cairncms/sdk. Describe your schema once, and collection names, fields, and query results are type-checked across REST, GraphQL, and realtime.',
		link: '/docs/api/sdk/',
		linkText: 'Use the SDK',
	},
	{
		icon: 'broadcast',
		title: 'Realtime updates',
		body: 'Push live data changes to your apps over WebSockets or GraphQL subscriptions. Updates follow the same permissions as every other API request.',
		link: '/docs/api/realtime/',
		linkText: 'Explore realtime',
	},
	{
		icon: 'box-seam',
		title: 'Sandboxed extensions',
		body: 'Extend the admin app and API with your own code. Give an extension full access, or run it in a sandbox that grants only the capabilities it declares.',
		link: '/docs/develop/extensions/',
		linkText: 'Build extensions',
	},
	{
		icon: 'clock-history',
		title: 'Activity log',
		body: 'Record who changed what and when, whether the change came from a person, an extension, or a config deployment. Trace any change back to its source.',
		link: '/docs/guides/content/activity-log/',
		linkText: 'Read about the activity log',
	},
	{
		icon: 'database',
		title: 'Bring your own database',
		body: 'Point CairnCMS at a new or existing PostgreSQL, MySQL, MariaDB, or SQLite database and keep the same admin experience, generated APIs, and automation layer.',
		link: '/docs/manage/configuration/',
		linkText: 'Configure your database',
	},
	{
		icon: 'hdd-stack',
		title: 'Horizontal scaling',
		body: 'Add API servers as your traffic grows, all sharing one database. Scheduled automations and live updates coordinate across servers through Redis.',
		link: '/docs/manage/configuration/#schedule-coordination',
		linkText: 'Coordinate replicas',
	},
	{
		icon: 'shield-lock',
		title: 'SSO and identity providers',
		body: 'OAuth 2.0, OpenID Connect, SAML, and LDAP out of the box. Bring your own identity provider and let CairnCMS sit behind it.',
		link: '/docs/guides/auth/',
		linkText: 'Set up SSO',
	},
];

