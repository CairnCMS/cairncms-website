---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (
	await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category))].sort();

const dateFormat = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<MarketingLayout title="Blog - CairnCMS" description="Release news, project updates, and articles from the CairnCMS project.">
	<Header />
	<main>
		<section class="section-pad">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8 text-center">
						<span class="eyebrow">CairnCMS</span>
						<h1>Blog</h1>
						<p class="lead mt-3 mb-3">News, updates, and articles from the project.</p>
						<a class="blog-rss" href="/rss.xml">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
								<path d="M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
								<path d="M2.5 3a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5A6.5 6.5 0 0 1 9 11.5a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5A8.5 8.5 0 0 0 2.5 3z"/>
								<path d="M2.5 6a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5A3.5 3.5 0 0 1 6 11.5a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5A5.5 5.5 0 0 0 2.5 6z"/>
							</svg>
							<span>RSS feed</span>
						</a>
					</div>
				</div>

				{
					categories.length > 1 && (
						<div class="blog-filters" role="group" aria-label="Filter posts by category">
							<button type="button" class="blog-filter is-active" data-filter="all">
								All
							</button>
							{categories.map((category) => (
								<button type="button" class="blog-filter" data-filter={category}>
									{category}
								</button>
							))}
						</div>
					)
				}

				{
					posts.length === 0 ? (
						<p class="text-center mt-5">No posts yet — check back soon.</p>
					) : (
						<div class="blog-list">
							{posts.map((post) => (
								<a class="blog-card" href={`/blog/${post.id}/`} data-category={post.data.category}>
									<span class="blog-card__category">{post.data.category}</span>
									<h2 class="blog-card__title">{post.data.title}</h2>
									<p class="blog-card__excerpt">{post.data.description}</p>
									<time class="blog-card__date" datetime={post.data.pubDate.toISOString()}>
										{dateFormat.format(post.data.pubDate)}
									</time>
								</a>
							))}
						</div>
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</MarketingLayout>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const cards = document.querySelectorAll<HTMLAnchorElement>('.blog-card');

	for (const button of filters) {
		button.addEventListener('click', () => {
			const selected = button.dataset.filter;

			for (const f of filters) f.classList.toggle('is-active', f === button);

			for (const card of cards) {
				const show = selected === 'all' || card.dataset.category === selected;
				card.hidden = !show;
			}
		});
	}
</script>
